---
import type { FeedNote } from "@/utils/getNotes";
import NoteCard from "./NoteCard.astro";

type Props = {
  notes: FeedNote[];
  /** Label for long-form cards, e.g. “长文”. */
  kindLabel?: string;
};

const { notes, kindLabel } = Astro.props;
---

{
  /*
  A profile grid, not a masonry: every cover is 3:4 and every title is clamped
  to two lines, so the browser's own grid keeps the rows aligned. Two columns on
  phones, three from 40rem — the proportions of a Xiaohongshu profile page.
*/
}
<div
  class="grid grid-cols-2 items-start gap-x-4 gap-y-5 sm:grid-cols-3 sm:gap-x-5 sm:gap-y-6"
>
  {notes.map(note => <NoteCard note={note} kindLabel={kindLabel} />)}
</div>

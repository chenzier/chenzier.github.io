---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

type TripEntry = {
  id: string;
  data: {
    title: string;
    series?: string;
    station?: number;
    destination?: string;
    region?: string;
    date?: Date;
    images?: string[];
    description?: string;
  };
  Content: any;
};

// 系列展示配置：图标 + 排序（其余归入“散记”）
const SERIES_ORDER = [
  { key: "环球旅行", emoji: "🌏" },
  { key: "平行宇宙", emoji: "🌀" },
];

const allTrips = (await getCollection("trips")).filter(
  trip => !trip.data.draft
);

const withContent: TripEntry[] = await Promise.all(
  allTrips.map(async trip => ({
    id: trip.id,
    data: trip.data as TripEntry["data"],
    Content: (await render(trip)).Content,
  }))
);

type TripGroup = {
  label: string;
  emoji: string;
  items: TripEntry[];
};

const groups: TripGroup[] = [];

for (const { key, emoji } of SERIES_ORDER) {
  const items = withContent
    .filter(trip => trip.data.series === key)
    .sort(
      (a, b) =>
        (a.data.station ?? Number.MAX_SAFE_INTEGER) -
        (b.data.station ?? Number.MAX_SAFE_INTEGER)
    );
  if (items.length > 0) groups.push({ label: key, emoji, items });
}

// 未归入系列的独立游记
const singles = withContent.filter(trip => !trip.data.series);
if (singles.length > 0) {
  groups.push({ label: "散记", emoji: "✍️", items: singles });
}

const total = withContent.length;

/** 朋友圈式图集：1 张全宽，2 张两列，3 张以上三列 */
const imageGridClass = (count: number) =>
  count >= 3 ? "grid-cols-3" : count === 2 ? "grid-cols-2" : "grid-cols-1";
---

<Layout title={`${t.pages.tripsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.tripsTitle} pageDesc={t.pages.tripsDesc}>
    {
      groups.map(group => (
        <section class="mt-8">
          <h2 class="flex items-baseline gap-2 text-lg font-semibold">
            <span aria-hidden="true">{group.emoji}</span>
            <span>{group.label}</span>
            <span class="text-muted-foreground text-xs font-normal">
              已解锁 {group.items.length} 篇
            </span>
          </h2>

          <ol class="mt-4 space-y-6">
            {group.items.map(trip => (
              <li>
                <article
                  class="border-border bg-background rounded-2xl border p-5 sm:p-6"
                  data-pagefind-body
                >
                  <header class="flex items-start justify-between gap-3">
                    <h3 class="text-lg leading-snug font-semibold break-all sm:text-xl">
                      {trip.data.title}
                    </h3>
                    {trip.data.station && (
                      <span class="text-accent border-accent/40 shrink-0 rounded-full border px-2.5 py-0.5 text-xs whitespace-nowrap">
                        第 {trip.data.station} 站
                      </span>
                    )}
                  </header>

                  {(trip.data.region || trip.data.destination) && (
                    <p class="text-muted-foreground mt-1.5 text-sm">
                      📍
                      {[trip.data.region, trip.data.destination]
                        .filter(Boolean)
                        .join(" · ")}
                    </p>
                  )}

                  {
                    trip.data.date && (
                      <p class="text-muted-foreground mt-1 text-xs">
                        {trip.data.date.toISOString().slice(0, 10)}
                      </p>
                    )
                  }

                  <div
                    class:list={[
                      "mt-4 text-foreground/90 text-[15px] leading-7 sm:text-base",
                      "[&>p]:mb-3 [&>p]:last:mb-0 [&_a]:text-accent [&_a]:underline",
                    ]}
                  >
                    <trip.Content />
                  </div>

                  {
                    trip.data.images && trip.data.images.length > 0 && (
                      <div
                        class:list={[
                          "mt-4 grid gap-2",
                          imageGridClass(trip.data.images.length),
                        ]}
                      >
                        {trip.data.images.map(src => (
                          <img
                            src={src}
                            alt=""
                            loading="lazy"
                            class="size-full aspect-square rounded-xl object-cover"
                          />
                        ))}
                      </div>
                    )
                  }
                </article>
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    {
      total === 0 && (
        <p class="text-muted-foreground mt-12 text-center">
          游记还在路上，敬请期待。
        </p>
      )
    }
  </Main>

  <Footer />
</Layout>

---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import NoteFeed from "@/components/feed/NoteFeed.astro";
import { getNotes } from "@/utils/getNotes";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

/** Same note cards as the home feed, limited to trip journals. */
const notes = (await getNotes(locale)).filter(note => note.kind === "trip");
const feedCount = t.home.notes;
---

<Layout title={`${t.pages.tripsTitle} | ${config.site.title}`}>
  <Header />

  <main id="main-content" data-surface="feed" class="feed-layout pb-16">
    <div class="flex items-end justify-between gap-4 pt-6 sm:pt-8">
      <div>
        <h1 class="text-home-ink text-xl font-bold sm:text-2xl">
          {t.pages.tripsTitle}
        </h1>
        <p class="text-home-ink-muted mt-1.5 text-sm">
          {t.pages.tripsDesc}
        </p>
      </div>
      <span class="text-home-ink-muted shrink-0 text-xs">
        {notes.length}
        {feedCount}
      </span>
    </div>

    <div class="mt-5 sm:mt-6">
      <NoteFeed notes={notes} kindLabel={t.home.longform} />
    </div>

    {
      notes.length === 0 && (
        <p class="text-home-ink-muted mt-12 text-center">
          {t.pages.tripsEmpty}
        </p>
      )
    }

    <div class="mt-10 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "")}>
        {t.nav.home}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
